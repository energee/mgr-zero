{
  "permissions": {
    "allow": [
      "Bash(bunx tsc --noEmit)",
      "Bash(bun run lint)",
      "Bash(bunx vitest run tests/*)",
      "Bash(git fetch)",
      "Bash(git fetch -q)",
      "Bash(git fetch -q origin)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-guard.sh"
          }
        ]
      }
    ]
  }
}
