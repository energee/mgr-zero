# Public Supabase endpoint and publishable key. Generate local values with:
# npx supabase status -o env | node scripts/supabase-env.mjs > .env.local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# Server-only Supabase key. Never expose it to the browser.
SUPABASE_SECRET_KEY=replace-with-local-service-role-key

# Optional Vercel deployment environment: production, preview, or development.
VERCEL_ENV=development
