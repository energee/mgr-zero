# Public Supabase endpoint and publishable key. Generate local values with:
# bunx supabase status -o env | node scripts/supabase-env.mjs > .env.local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# Server-only Supabase key. Never expose it to the browser.
SUPABASE_SECRET_KEY=replace-with-local-service-role-key

# Optional Vercel deployment environment: production, preview, or development.
VERCEL_ENV=development

# Server-only Slack notification configuration. Leave unset until a Slack app
# and the dedicated chat-state database login have been created.
APP_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
CHAT_SDK_ENCRYPTION_KEY=
CHAT_STATE_DATABASE_URL=
CHAT_JOB_SECRET=

# vitest reads .env.test.local (written by `bash scripts/test-db.sh`) on top of
# this file: the throwaway mgr_test stack on 54351/54352. Never point the app there.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54352/postgres

# Optional: hide and reject hosted-web brewery creation. Authenticated API provisioning remains available.
# MGR_DEDICATED=1
